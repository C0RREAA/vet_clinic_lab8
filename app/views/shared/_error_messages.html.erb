<% if object.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <h5 class="alert-heading mb-2">
      <%= pluralize(object.errors.count, "error") %> prevented this <%= object.class.name.downcase %> from being saved:
    </h5>
    <ul class="mb-0">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
