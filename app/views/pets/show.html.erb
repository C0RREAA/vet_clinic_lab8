<%= link_to "← Back to Pets", pets_path, class: "btn btn-secondary mb-3" %>
<h1 class="mb-4"><%= @pet.name %></h1>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <p><strong>Species:</strong> <%= @pet.species %></p>
    <p><strong>Breed:</strong> <%= @pet.breed %></p>
    <p><strong>Date of Birth:</strong> <%= @pet.date_of_birth.strftime("%B %d, %Y") %></p>
    <p><strong>Weight:</strong> <%= @pet.weight %> kg</p>
    <p><strong>Owner:</strong> <%= link_to "#{@pet.owner.first_name} #{@pet.owner.last_name}", owner_path(@pet.owner) %></p>
  </div>
</div>

<h4>Appointments</h4>
<table class="table table-bordered table-hover">
  <thead class="table-dark">
    <tr><th>Date</th><th>Reason</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% @pet.appointments.each do |appt| %>
      <tr>
        <td><%= link_to appt.date.strftime("%B %d, %Y %H:%M"), appointment_path(appt) %></td>
        <td><%= appt.reason %></td>
        <td><%= ["Scheduled", "In Progress", "Completed", "Cancelled"][appt.status] %></td>
      </tr>
    <% end %>
  </tbody>
</table>